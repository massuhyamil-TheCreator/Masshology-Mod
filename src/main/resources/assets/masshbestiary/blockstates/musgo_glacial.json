{
  "multipart": [
    { "when": { "up": "true" }, "apply": { "model": "masshbestiary:block/musgo_glacial" } },
    { "when": { "down": "true" }, "apply": { "model": "masshbestiary:block/musgo_glacial", "x": 180 } },
    { "when": { "north": "true" }, "apply": { "model": "masshbestiary:block/musgo_glacial", "x": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "masshbestiary:block/musgo_glacial", "x": 90, "y": 180 } },
    { "when": { "east": "true" }, "apply": { "model": "masshbestiary:block/musgo_glacial", "x": 90, "y": 90 } },
    { "when": { "west": "true" }, "apply": { "model": "masshbestiary:block/musgo_glacial", "x": 90, "y": 270 } }
  ]
}